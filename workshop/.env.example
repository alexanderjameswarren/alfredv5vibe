# Workshop — per-host config. Copy to .env and edit; .env is gitignored.
# Every value here has a corresponding key in workshop/config.py.

# Host identity — returned by /health and get_workshop_status.
# `desktop` = staging, `surface` = production (LAN-resident).
WORKSHOP_HOST_ID=desktop

# Loopback port. Cloudflared tunnels to this via 127.0.0.1:${WORKSHOP_PORT}.
WORKSHOP_PORT=7777

# Public origin the tunnel exposes this host at. Used to derive the
# protected-resource `resource` value, so it MUST match the connector's
# server URL exactly (scheme + host, no path, no trailing slash).
WORKSHOP_PUBLIC_ORIGIN=https://workshop-dev.alexanderjameswarren.com

# Auth mode. `strict` is the resting configuration; `permissive` is a
# temporary state during the first-token discovery pass (spec §3.4).
# Set to permissive ONLY while running the pass-1 rollout on the desktop;
# never on the Surface, and never for more than one conversation.
WORKSHOP_AUTH_MODE=strict

# Supabase issuer — the /auth/v1 path, not the domain root. Metadata is
# served at /auth/v1/.well-known/oauth-authorization-server; anything above
# the /auth/v1 prefix 404s.
SUPABASE_ISSUER=https://zuqjyfqnvhddnchhpbcz.supabase.co/auth/v1

# Comma-separated Supabase user IDs allowed to call tools. This is the
# single-user backstop against `aud` being ignored — any token from this
# Supabase project (Alfred's React app included) is otherwise valid at
# Workshop. See spec §3.4 for the threat model.
ALLOWED_SUBS=26f0707f-b586-4a3e-841c-8c313d6ab1e5
