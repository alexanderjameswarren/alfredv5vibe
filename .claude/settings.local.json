{
  "permissions": {
    "allow": [
      "Bash(dir:*)",
      "Bash(findstr:*)",
      "Bash(git log:*)",
      "Bash(node scripts/claims.mjs status)",
      "Bash(node scripts/claims.mjs status:*)",
      "Bash(node scripts/claims.mjs check:*)",
      "Bash(node scripts/claims.mjs release:*)",
      "Bash(node scripts/claims.mjs claim:*)",
      "Bash(node scripts/claims.mjs reserve:*)",
      "Bash(node scripts/claims.mjs yield:*)",
      "Bash(npx eslint:*)",
      "Bash(npx react-scripts build:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm install:*)",
      "Bash(npx supabase:*)",
      "Bash(npx vite build)",
      "Bash(npx vite build:*)",
      "WebFetch(domain:cdn.jsdelivr.net)",
      "Bash(npx --no-install eslint:*)",
      "Bash(npm run build:*)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:jsr.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:hono.dev)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db execute:*)",
      "mcp__claude_ai_Aflred_v5__search_items",
      "mcp__claude_ai_Aflred_v5__get_database_schema",
      "Bash(ls:*)",
      "Bash(node src/utils/recurrence.test.js)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/claude-sessions/run-tests.ps1)",
      "Read(//c/Users/Alex/projects/alfred-v5/.git/alfred-claims.json)",
      "Read(//c/Users/Alex/projects/alfred-v5/.git/alfred-project-code.json)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-check.mjs\""
        }, {
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-notice.mjs\""
        }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [{
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/claims-guard.mjs\""
        }]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [{
          "type": "command",
         "command": "powershell.exe -NoProfile -c \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Windows Ringout.wav').PlaySync()\""
        }, {
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-status.mjs\""
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [{
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-status.mjs\""
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "powershell.exe -NoProfile -c \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Windows Ringout.wav').PlaySync()\""
        }, {
          "type": "command",
          "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-status.mjs\""
        }]
      }
    ]
  }
}
