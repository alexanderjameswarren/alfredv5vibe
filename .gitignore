# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# songs
/songs
/separated

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated schema copies — master lives at repo root (sam-drill-format.schema.json).
# scripts/prebuild.js regenerates these on every build/start so they cannot drift.
/src/sam/lib/sam-drill-format.schema.json
/supabase/functions/_shared/sam-drill-format.schema.json

# CLI report staging for scripts/clip.mjs. The report is pushed into Alfred,
# not committed - it is a message, not source.
/.clip

# Supabase CLI scratch state. Machine-local and rewritten by the CLI itself — the
# linked project ref, the pooler URL, and the versions of the services it last saw.
# `cli-latest` in particular is bumped by any `supabase` command, so it turned up as a
# pending change in the middle of unrelated work.
/supabase/.temp/
